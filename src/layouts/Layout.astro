---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MetaSEO from "../components/MetaSEO.astro";
import type { MetaSEOProperties } from "../components/MetaSEO.astro";

interface LayoutProps extends MetaSEOProperties {
  wide?: boolean;
}

const { title, description, image, article, wide = false } = Astro.props;

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Astrid Lapinski",
  "jobTitle": "Software architect",
  "alumniOf": { "@type": "CollegeOrUniversity", "name": "Drexel University" },
  "knowsAbout": ["Software architecture", "Legacy code documentation", "Systems thinking", "Ethical AI adoption", "Accessibility", "Mentoring"],
  "url": "https://rainbowfern.com/",
  "sameAs": []
};

const professionalServiceJsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": "Rainbowfern LLC",
  "url": "https://rainbowfern.com/",
  "founder": { "@type": "Person", "name": "Astrid Lapinski" },
  "email": "contact@rainbowfern.com",
  "areaServed": [{ "@type": "Place", "name": "Remote" }, { "@type": "Place", "name": "Philadelphia region" }]
};
---

<!doctype html>
<html lang="en">
  <head>
    <MetaSEO
        title={title}
        description={description}
        image={image}
        article={article}
    />
    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(professionalServiceJsonLd)}></script>

    <!-- Runs before first paint so the page never flashes the wrong theme. -->
    <script is:inline>
      (() => {
        const stored = (() => {
          try {
            return sessionStorage.getItem('theme-override');
          } catch (e) {
            return null;
          }
        })();
        const system = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme =
          stored === 'light' || stored === 'dark' ? stored : system;
      })();
    </script>
  </head>
  <body class="flex min-h-dvh flex-col bg-page text-ink antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:inline-flex focus:min-h-11 focus:items-center focus:rounded-md focus:bg-page focus:px-4 focus:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
    >Skip to main content</a>
    <Header />
    <main id="main" class={`mx-auto w-full flex-1 px-6 py-10 ${wide ? 'max-w-7xl' : 'max-w-3xl'}`}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
