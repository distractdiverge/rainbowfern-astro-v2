<section aria-labelledby="doors-heading">
  <h2 id="doors-heading" class="text-2xl font-semibold text-heading">Three ways to start</h2>
  <ul class="mt-6 grid gap-4">
    <li class="rounded-md bg-card p-6 shadow-paper ring-1 ring-line">
      <h3 class="text-lg font-semibold text-heading">Free intro call</h3>
      <p class="text-ink-soft">Book a free 30-minute intro call.</p>
      <div data-scheduler-slot class="mt-4 rounded-md p-4 text-ink-soft ring-1 ring-line">[SCHEDULER EMBED: Calendly or similar]</div>
    </li>
    <li class="rounded-md bg-card p-6 shadow-paper ring-1 ring-line">
      <h3 class="text-lg font-semibold text-heading">Unstuck session</h3>
      <p class="text-ink-soft">Book a paid Unstuck session, 60 or 90 minutes. Pay when you book.</p>
      <a href="/sessions" class="mt-4 inline-flex min-h-11 items-center text-accent hover:underline">See Unstuck sessions</a>
    </li>
    <li class="rounded-md bg-card p-6 shadow-paper ring-1 ring-line">
      <h3 class="text-lg font-semibold text-heading">Email</h3>
      <p class="text-ink-soft">Prefer email? Write to contact@rainbowfern.com. I reply within [TBD: response time].</p>
      <a href="mailto:contact@rainbowfern.com" class="mt-4 inline-flex min-h-11 items-center text-accent hover:underline">contact@rainbowfern.com</a>
    </li>
  </ul>
</section>
