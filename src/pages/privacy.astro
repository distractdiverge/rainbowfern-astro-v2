---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Privacy" description="Privacy at Rainbowfern: no ads, no third-party trackers, and basic privacy-respecting analytics only.">
  <h1 class="text-3xl font-bold text-heading">Privacy</h1>
  <p class="mt-4 text-ink-soft">This site runs no ads and no third-party trackers.</p>

  <section class="mt-12" aria-labelledby="analytics-heading">
    <h2 id="analytics-heading" class="text-2xl font-semibold text-heading">Analytics</h2>
    <p class="mt-4 text-ink-soft">The site uses basic, privacy-respecting analytics only: cookieless, with no personal data. [TBD: name the analytics tool].</p>
  </section>

  <section class="mt-12" aria-labelledby="contact-heading">
    <h2 id="contact-heading" class="text-2xl font-semibold text-heading">Contact</h2>
    <p class="mt-4 text-ink-soft">Questions about this page: <a href="mailto:contact@rainbowfern.com" class="text-accent hover:underline inline-flex min-h-11 items-center">contact@rainbowfern.com</a>.</p>
  </section>
</Layout>
