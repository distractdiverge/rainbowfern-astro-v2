---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Accessibility" description="Accessibility statement for Rainbowfern: the standard we target and how to report a problem.">
  <h1 class="text-3xl font-bold text-heading">Accessibility</h1>
  <p class="mt-4 text-ink-soft">I aim to meet WCAG 2.2 AA across the site, and I want to hear about anything that doesn't work for you.</p>

  <section class="mt-12" aria-labelledby="in-place-heading">
    <h2 id="in-place-heading" class="text-2xl font-semibold text-heading">What is in place</h2>
    <ul class="mt-4 list-disc pl-6 text-ink-soft space-y-2">
      <li>A skip link on every page</li>
      <li>Keyboard focus is always visible</li>
      <li>Motion respects your reduced-motion setting</li>
      <li>Text is solid colour on paper and screen, with no gradients</li>
    </ul>
  </section>

  <section class="mt-12" aria-labelledby="report-heading">
    <h2 id="report-heading" class="text-2xl font-semibold text-heading">Report a problem</h2>
    <p class="mt-4 text-ink-soft">[TBD: response time]. Email <a href="mailto:contact@rainbowfern.com" class="text-accent hover:underline inline-flex min-h-11 items-center">contact@rainbowfern.com</a>.</p>
  </section>
</Layout>
