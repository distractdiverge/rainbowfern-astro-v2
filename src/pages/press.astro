---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Press" description="Press information for Astrid Lapinski, including a third-person bio for reuse.">
  <h1 class="text-3xl font-bold text-heading">Press</h1>
  <p class="mt-4 text-ink-soft">A ready-to-paste third-person bio, and a headshot for press use.</p>

  <section class="mt-12" aria-labelledby="bio-heading">
    <h2 id="bio-heading" class="text-2xl font-semibold text-heading">Bio</h2>
    <p class="mt-4 text-ink-soft">Astrid Lapinski is a software architect and the founder of Rainbowfern, a one-person consulting practice in northwest Philadelphia. They spent 15+ years at PayPal as an engineer, manager and architect, including as one of three architects on the PayPal Credit platform. [TBD: pronouns: confirm with Astrid before publishing; they/them used until stated].</p>
  </section>

  <section class="mt-12" aria-labelledby="headshot-heading">
    <h2 id="headshot-heading" class="text-2xl font-semibold text-heading">Headshot</h2>
    <p class="mt-4 text-ink-soft">[TBD: headshot file for press use]</p>
  </section>
</Layout>
