---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Unstuck sessions" description="Unstuck sessions: a 60 or 90 minute call to work through one problem, booked and paid online.">
  <h1 class="text-3xl font-bold text-heading">Unstuck sessions</h1>
  <p class="mt-4 text-ink-soft">An Unstuck session is a 60 or 90 minute call to work through one problem. You book it and pay online.</p>

  <section class="mt-12" aria-labelledby="price-heading">
    <h2 id="price-heading" class="text-2xl font-semibold text-heading">Price</h2>
    <p class="mt-4 text-ink-soft">[PRICE TBD] for 60 min, [PRICE TBD] for 90 min, paid at booking.</p>
  </section>

  <section class="mt-12" aria-labelledby="book-heading">
    <h2 id="book-heading" class="text-2xl font-semibold text-heading">Book a slot</h2>
    <p class="mt-4 text-ink-soft"><a href="#scheduler" class="underline">[SCHEDULER EMBED: Calendly or similar]</a></p>
  </section>
</Layout>
