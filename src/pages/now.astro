---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Now" description="What Astrid Lapinski is taking on right now and what she is focused on.">
  <h1 class="text-3xl font-bold text-heading">Now</h1>
  <p class="mt-4 text-ink-soft">What I'm taking on and what I'm focused on at the moment.</p>

  <section class="mt-12" aria-labelledby="availability-heading">
    <h2 id="availability-heading" class="text-2xl font-semibold text-heading">Availability</h2>
    <p class="mt-4 text-ink-soft">[TBD: dated availability, e.g. 'As of &lt;date&gt;: taking ...']</p>
  </section>

  <section class="mt-12" aria-labelledby="focus-heading">
    <h2 id="focus-heading" class="text-2xl font-semibold text-heading">Current focus</h2>
    <p class="mt-4 text-ink-soft">[TBD: current focus]</p>
  </section>
</Layout>
