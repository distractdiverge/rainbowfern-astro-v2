---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Mentoring and coaching" description="Privacy-protected mentoring and coaching for engineers from underrepresented and non-traditional paths.">
  <h1 class="text-3xl font-bold text-heading">Mentoring and coaching</h1>
  <p class="mt-4 text-ink-soft">Privacy-protected mentoring for engineers from underrepresented and non-traditional paths.</p>

  <section class="mt-12" aria-labelledby="privacy-heading">
    <h2 id="privacy-heading" class="text-2xl font-semibold text-heading">Privacy</h2>
    <p class="mt-4 text-ink-soft">[TBD: privacy practices, see voice/content-strategy]</p>
  </section>

  <section class="mt-12" aria-labelledby="fees-heading">
    <h2 id="fees-heading" class="text-2xl font-semibold text-heading">Fees</h2>
    <p class="mt-4 text-ink-soft">Sliding scale: standard [PRICE TBD], floor [PRICE TBD].</p>
  </section>
</Layout>
