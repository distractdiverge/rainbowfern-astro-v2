---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Pricing" description="Pricing for Rainbowfern: a standard rate, a solidarity rate, and a sliding scale.">
  <h1 class="text-3xl font-bold text-heading">Pricing</h1>
  <p class="mt-4 text-ink-soft">Pay what your situation allows. You'll get the same work either way.</p>

  <section class="mt-12" aria-labelledby="scale-heading">
    <h2 id="scale-heading" class="text-2xl font-semibold text-heading">Sliding scale</h2>
    <ul class="mt-6 space-y-4">
      <li class="rounded-lg bg-card p-5 shadow-paper ring-1 ring-line">
        <h3 class="text-lg font-semibold text-heading">Standard rate</h3>
        <p class="mt-1 text-ink-muted">[PRICE TBD]</p>
      </li>
      <li class="rounded-lg bg-card p-5 shadow-paper ring-1 ring-line">
        <h3 class="text-lg font-semibold text-heading">Solidarity rate</h3>
        <p class="mt-1 text-ink-muted">[PRICE TBD]</p>
      </li>
    </ul>
  </section>

  <section class="mt-12" aria-labelledby="capacity-heading">
    <h2 id="capacity-heading" class="text-2xl font-semibold text-heading">Capacity</h2>
    <p class="mt-4 text-ink-soft">[TBD: capacity, e.g. 'I take two solidarity-rate projects at a time']</p>
  </section>

  <section class="mt-12" aria-labelledby="allocation-heading">
    <h2 id="allocation-heading" class="text-2xl font-semibold text-heading">Where the fee goes</h2>
    <p class="mt-4 text-ink-soft">[TBD: fee allocation]</p>
  </section>
</Layout>
