---
import Layout from '../layouts/Layout.astro';
---

<Layout title="CV" description="CV of Astrid Lapinski: role history, education, and experience.">
  <h1 class="text-3xl font-bold text-heading">CV</h1>
  <p class="mt-4 text-ink-soft">Open to Technical Product Owner and architect roles.</p>

  <section class="mt-12" aria-labelledby="history-heading">
    <h2 id="history-heading" class="text-2xl font-semibold text-heading">Role history</h2>
    <p class="mt-4 text-ink-soft">[TBD: role history]</p>
  </section>

  <section class="mt-12" aria-labelledby="more-heading">
    <h2 id="more-heading" class="text-2xl font-semibold text-heading">More detail</h2>
    <ul class="mt-4 space-y-2 text-ink-soft">
      <li><a href="/education" class="underline">Education and skills</a></li>
      <li><a href="/experience" class="underline">Experience</a></li>
    </ul>
  </section>

  <section class="mt-12" aria-labelledby="download-heading">
    <h2 id="download-heading" class="text-2xl font-semibold text-heading">Download</h2>
    <p class="mt-4 text-ink-soft">[TBD: résumé PDF]</p>
  </section>
</Layout>
